DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_dev
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/nexus_dev
# LLM provider keys (uncomment as needed)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# Auth (Auth.js / NextAuth v5)
NEXTAUTH_SECRET=change-me-in-production
# AUTH_SECRET is also accepted and takes precedence when set.
NEXTAUTH_URL=http://localhost:3000
# Comma-separated invite allowlist. Empty = fail closed in production.
ALLOWED_EMAILS=you@example.com
# Comma-separated admin allowlist for /api/admin/*. Empty = admin routes deny all.
ADMIN_EMAILS=you@example.com
# Shared secret for Vercel Cron -> /api/admin/audit (x-cron-secret header).
# CRON_SECRET=
# Magic-link transport: console (default) | resend | postmark | ses
EMAIL_PROVIDER=console
EMAIL_FROM=Nexus <no-reply@nexus.local>
# EMAIL_API_KEY=
# Wikipedia
WIKIPEDIA_CONTACT_EMAIL=dev@example.com
# Budget
GLOBAL_DAILY_BUDGET_USD=5
GLOBAL_MONTHLY_BUDGET_USD=100
